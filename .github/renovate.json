{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "semanticCommits": "enabled",
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "automerge": false
    },
    {
      "matchPackageNames": [
        "ratatui",
        "tui-logger"
      ],
      "groupName": "tui"
    },
    {
      "matchPackageNames": [
        "*"
      ],
      "automerge": true
    }
  ]
}
